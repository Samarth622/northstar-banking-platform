# =====================================================================
# Northstar Banking Platform - .gitignore
#
# Commit:       source code, build configuration, migrations, docs and
#               configuration TEMPLATES such as .env.example.
# Never commit: build output, machine/IDE-specific files, logs,
#               database dumps, and anything that contains a secret.
#
# Remember: .gitignore only affects UNTRACKED files. It does nothing for
# files already committed, and nothing for Git history.
#
# Which rule ignores a file?        git check-ignore -v <path>
# What is currently being ignored?  git status --ignored
# =====================================================================


# ---------------------------------------------------------------------
# Maven build output
# Regenerated on every build; committing it causes huge, noisy diffs.
#
# Do NOT ignore mvnw, mvnw.cmd or .mvn/wrapper/maven-wrapper.properties.
# The Maven Wrapper must be committed so every machine builds identically.
# When Spring Initializr generates its own .gitignore (Assignment 3),
# merge its wrapper-related lines into this file instead of overwriting.
# ---------------------------------------------------------------------
target/

# Generated by Spring Initializr; not part of the project documentation.
HELP.md


# ---------------------------------------------------------------------
# Secrets and local environment configuration
# The real .env holds local credentials and must never be committed.
# .env.example (placeholders only) IS committed.
# The "!" negation re-includes it, and it must come AFTER the rules
# that would otherwise ignore it.
# ---------------------------------------------------------------------
.env
.env.*
!.env.example

# Private keys, certificates and keystores
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.truststore


# ---------------------------------------------------------------------
# Logs and JVM diagnostics
# Logs can leak sensitive values; heap dumps contain everything that was
# in memory, including credentials.
# ---------------------------------------------------------------------
logs/
*.log
*.hprof
replay_pid*


# ---------------------------------------------------------------------
# Database dumps and local data
# WARNING: never add *.sql here - Flyway migrations are .sql files.
# ---------------------------------------------------------------------
*.dump
*.backup
backups/
# Only relevant if you ever bind-mount a local PostgreSQL data directory
postgres-data/


# ---------------------------------------------------------------------
# IntelliJ IDEA
# ---------------------------------------------------------------------
.idea/
*.iml
*.iws
*.ipr
out/


# ---------------------------------------------------------------------
# VS Code
# ---------------------------------------------------------------------
.vscode/


# ---------------------------------------------------------------------
# Eclipse / Spring Tools
# ---------------------------------------------------------------------
.apt_generated/
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache/
bin/


# ---------------------------------------------------------------------
# Operating system files
# ---------------------------------------------------------------------
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# macOS / Linux (for anyone else who clones the repository)
.DS_Store
*~


# ---------------------------------------------------------------------
# Temporary and editor backup files
# ---------------------------------------------------------------------
*.tmp
*.bak
*.swp